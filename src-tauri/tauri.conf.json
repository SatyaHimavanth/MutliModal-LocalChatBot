{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multimodal Local Chatbot",
  "version": "1.0.0",
  "identifier": "com.organization.multimodal-local-chatbot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Multimodal Local Chatbot",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:8080; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"]
  }
}
